# Copy to .env.local for local development (gitignored) and set the same
# names in Vercel > Project > Settings > Environment Variables.

# Supabase: Project Settings > Data API (URL) and API Keys
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-only; bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string. Local only: used by `supabase db push`.
SUPABASE_DB_URL=

# App lock: owner passcode (full access) and optional viewer passcode (read-only)
APP_PASSCODE=
VIEWER_PASSCODE=
# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SESSION_SECRET=
APP_TOKEN_SECRET=

# Strava API app (strava.com/settings/api). Optional: keys can also be saved from Settings.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Origin Strava redirects back to: http://localhost:8080 locally, the Vercel URL in production.
PUBLIC_ORIGIN=

# AI coach: Google AI Studio key (aistudio.google.com). GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=
